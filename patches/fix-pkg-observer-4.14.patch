diff --git a/KernelSU-Next/kernel/manager/pkg_observer.c b/KernelSU-Next/kernel/manager/pkg_observer.c
index 799246f4..e15d249c 100644
--- a/KernelSU-Next/kernel/manager/pkg_observer.c
+++ b/KernelSU-Next/kernel/manager/pkg_observer.c
@@ -36,14 +36,39 @@ static int ksu_handle_inode_event(struct fsnotify_mark *mark, u32 mask,
     return 0;
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 1, 0)
+static int ksu_handle_event(struct fsnotify_group *group, struct inode *inode,
+                            struct fsnotify_mark *inode_mark,
+                            struct fsnotify_mark *vfsmount_mark, u32 mask,
+                            const void *data, int data_type,
+                            const unsigned char *file_name, u32 cookie,
+                            struct fsnotify_iter_info *iter_info)
+{
+    if (!file_name)
+        return 0;
+    if (mask & FS_ISDIR)
+        return 0;
+    if (strlen(file_name) == 13 && !memcmp(file_name, "packages.list", 13)) {
+        pr_info("packages.list detected: %d\n", mask);
+        track_throne(false);
+    }
+    return 0;
+}
+#endif
+
 static const struct fsnotify_ops ksu_ops = {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0)
 	.handle_inode_event = ksu_handle_inode_event,
+#else
+	.handle_event = ksu_handle_event,
+#endif
 };
 
 static int add_mark_on_inode(struct inode *inode, u32 mask,
                              struct fsnotify_mark **out)
 {
 	struct fsnotify_mark *m;
+	int ret;
 
 	m = kzalloc(sizeof(*m), GFP_KERNEL);
 	if (!m)
@@ -52,7 +77,12 @@ static int add_mark_on_inode(struct inode *inode, u32 mask,
 	fsnotify_init_mark(m, g);
 	m->mask = mask;
 
-	if (fsnotify_add_inode_mark(m, inode, 0)) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0)
+	ret = fsnotify_add_inode_mark(m, inode, 0);
+#else
+	ret = fsnotify_add_mark(m, inode, NULL, 0);
+#endif
+	if (ret) {
 		fsnotify_put_mark(m);
 		return -EINVAL;
 	}
@@ -108,11 +138,17 @@ int ksu_observer_init(void)
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 0, 0)
 	g = fsnotify_alloc_group(&ksu_ops, 0);
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0)
+	g = fsnotify_alloc_group(&ksu_ops);
 #else
 	g = fsnotify_alloc_group(&ksu_ops);
+	if (!g)
+		return -ENOMEM;
 #endif
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 1, 0)
 	if (IS_ERR(g))
 		return PTR_ERR(g);
+#endif
 
 	ret = watch_one_dir(&g_watch);
 	pr_info("observer init done\n");
