[
  {
    "kernelSource": {
      "name": "chopin-KernelSU-Next",
      "repo": "https://github.com/ChopinKernels/android_kernel_chopin_android_T",
      "branch": "T",
      "device": "chopin",
      "defconfig": "chopin_user_defconfig"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/ThankYouMario/android_prebuilts_clang-standalone",
        "branch": "18",
        "name": "clang-18",
        "binPath": ["bin"]
      },
      {
        "url": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/+archive/refs/tags/android-14.0.0_r67.tar.gz",
        "name": "gcc",
        "binPath": ["bin"]
      },
      {
        "url": "https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/+archive/refs/tags/android-14.0.0_r67.tar.gz",
        "name": "gcc32",
        "binPath": ["bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang-18/bin/clang",
      "externalCommand": {
        "CLANG_TRIPLE": "aarch64-linux-gnu-",
        "CROSS_COMPILE": "gcc/bin/aarch64-linux-android-",
        "CROSS_COMPILE_ARM32": "gcc32/bin/arm-linux-androideabi-",
        "LD": "clang-18/bin/ld.lld",
        "AR": "clang-18/bin/llvm-ar",
        "NM": "clang-18/bin/llvm-nm",
        "OBJCOPY": "clang-18/bin/llvm-objcopy",
        "OBJDUMP": "clang-18/bin/llvm-objdump",
        "READELF": "clang-18/bin/llvm-readelf",
        "OBJSIZE": "clang-18/bin/llvm-size",
        "STRIP": "clang-18/bin/llvm-strip"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]
